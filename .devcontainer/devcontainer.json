{
  "name": "BISOF 09 - Sala de Eventos",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-8.0-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "files.autoSave": "afterDelay"
      }
    }
  },
  "postCreateCommand": "dotnet --version && dotnet build src/SalaEventos.csproj",
  "postAttachCommand": "echo 'Entorno listo. Para ejecutar el sistema:  cd src && dotnet run'"
}
